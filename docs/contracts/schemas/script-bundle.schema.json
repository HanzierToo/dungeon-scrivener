{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dungeon-scrivener:schema:v1:script-bundle",
  "title": "DungeonScrivener compiled script bundle v1",
  "type": "object",
  "properties": {
    "format": { "const": "dungeon-scrivener-compiled-script-bundle" },
    "schemaVersion": { "const": 1 },
    "scripts": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": { "$ref": "urn:dungeon-scrivener:schema:v1:script-ir" }
    }
  },
  "required": ["format", "schemaVersion", "scripts"],
  "additionalProperties": false
}
