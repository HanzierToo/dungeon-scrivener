{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dungeon-scrivener:schema:v1:script-ir",
  "title": "DungeonScrivener compiled script IR v1",
  "type": "object",
  "$defs": {
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "literal"
            },
            "value": {
              "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/scalar"
            },
            "span": {
              "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/sourceSpan"
            }
          },
          "required": [
            "kind",
            "value",
            "span"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "local"
            },
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
            },
            "span": {
              "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/sourceSpan"
            }
          },
          "required": [
            "kind",
            "name",
            "span"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "array"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              }
            },
            "span": {
              "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/sourceSpan"
            }
          },
          "required": [
            "kind",
            "items",
            "span"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "map"
            },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "value": {
                    "$ref": "#/$defs/expression"
                  }
                },
                "required": [
                  "key",
                  "value"
                ],
                "additionalProperties": false
              }
            },
            "span": {
              "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/sourceSpan"
            }
          },
          "required": [
            "kind",
            "entries",
            "span"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "index"
            },
            "target": {
              "$ref": "#/$defs/expression"
            },
            "index": {
              "$ref": "#/$defs/expression"
            },
            "span": {
              "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/sourceSpan"
            }
          },
          "required": [
            "kind",
            "target",
            "index",
            "span"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "unary"
            },
            "operator": {
              "enum": [
                "not",
                "negate"
              ]
            },
            "operand": {
              "$ref": "#/$defs/expression"
            },
            "span": {
              "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/sourceSpan"
            }
          },
          "required": [
            "kind",
            "operator",
            "operand",
            "span"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "binary"
            },
            "operator": {
              "enum": [
                "add",
                "subtract",
                "multiply",
                "divide",
                "modulo",
                "concat",
                "equal",
                "not-equal",
                "less-than",
                "less-or-equal",
                "greater-than",
                "greater-or-equal",
                "and",
                "or"
              ]
            },
            "left": {
              "$ref": "#/$defs/expression"
            },
            "right": {
              "$ref": "#/$defs/expression"
            },
            "span": {
              "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/sourceSpan"
            }
          },
          "required": [
            "kind",
            "operator",
            "left",
            "right",
            "span"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "call"
            },
            "target": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "helper"
                    },
                    "name": {
                      "type": "string",
                      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
                    }
                  },
                  "required": [
                    "kind",
                    "name"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "capability"
                    },
                    "name": {
                      "enum": [
                        "api.read",
                        "api.hasTag",
                        "api.request",
                        "api.emit",
                        "api.randomInt",
                        "api.randomFloat",
                        "len"
                      ]
                    }
                  },
                  "required": [
                    "kind",
                    "name"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "arguments": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              }
            },
            "span": {
              "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/sourceSpan"
            }
          },
          "required": [
            "kind",
            "target",
            "arguments",
            "span"
          ],
          "additionalProperties": false
        }
      ]
    },
    "statement": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "declare-local"
            },
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
            },
            "mutable": {
              "type": "boolean"
            },
            "value": {
              "$ref": "#/$defs/expression"
            },
            "span": {
              "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/sourceSpan"
            }
          },
          "required": [
            "kind",
            "name",
            "mutable",
            "value",
            "span"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "assign-local"
            },
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
            },
            "value": {
              "$ref": "#/$defs/expression"
            },
            "span": {
              "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/sourceSpan"
            }
          },
          "required": [
            "kind",
            "name",
            "value",
            "span"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "if"
            },
            "condition": {
              "$ref": "#/$defs/expression"
            },
            "then": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/statement"
              }
            },
            "else": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/statement"
              }
            },
            "span": {
              "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/sourceSpan"
            }
          },
          "required": [
            "kind",
            "condition",
            "then",
            "else",
            "span"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "while"
            },
            "condition": {
              "$ref": "#/$defs/expression"
            },
            "body": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/statement"
              }
            },
            "span": {
              "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/sourceSpan"
            }
          },
          "required": [
            "kind",
            "condition",
            "body",
            "span"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "expression"
            },
            "expression": {
              "$ref": "#/$defs/expression"
            },
            "span": {
              "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/sourceSpan"
            }
          },
          "required": [
            "kind",
            "expression",
            "span"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "return"
            },
            "value": {
              "$ref": "#/$defs/expression"
            },
            "span": {
              "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/sourceSpan"
            }
          },
          "required": [
            "kind",
            "span"
          ],
          "additionalProperties": false
        }
      ]
    },
    "function": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
        },
        "parameters": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
          }
        },
        "body": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/statement"
          }
        },
        "span": {
          "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/sourceSpan"
        }
      },
      "required": [
        "name",
        "parameters",
        "body",
        "span"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "format": {
      "const": "dungeon-scrivener-script-ir"
    },
    "schemaVersion": {
      "const": 1
    },
    "scriptId": {
      "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/id"
    },
    "sourceLanguage": {
      "enum": [
        "javascript",
        "lua",
        "python"
      ]
    },
    "sourcePath": {
      "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/path"
    },
    "entrypoint": {
      "const": "main"
    },
    "functions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/function"
      }
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "scriptId",
    "sourceLanguage",
    "sourcePath",
    "entrypoint",
    "functions"
  ],
  "additionalProperties": false
}
