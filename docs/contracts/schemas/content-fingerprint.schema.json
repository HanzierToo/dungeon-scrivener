{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dungeon-scrivener:schema:v1:content-fingerprint",
  "title": "DungeonScrivener playable-content fingerprint v1",
  "type": "object",
  "properties": {
    "format": { "const": "dungeon-scrivener-content-fingerprint" },
    "schemaVersion": { "const": 1 },
    "algorithm": { "const": "sha-256" },
    "scope": { "const": "playable-files-v1" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "files": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "path": { "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/path" },
          "byteLength": { "type": "integer", "minimum": 0 },
          "sha256": { "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/sha256" }
        },
        "required": ["path", "byteLength", "sha256"],
        "additionalProperties": false
      }
    }
  },
  "required": ["format", "schemaVersion", "algorithm", "scope", "digest", "files"],
  "additionalProperties": false
}
