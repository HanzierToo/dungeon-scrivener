        "payloadFields"
      ],
      "additionalProperties": false
    },
    "ruleTrigger": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "event"
            },
            "eventId": {
              "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/id"
            }
          },
          "required": [
            "kind",
            "eventId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "phase"
            },
            "phase": {
              "enum": [
                "action-start",
                "node-entry",
                "node-revisit",
                "node-exit",
                "time-advanced"
              ]
            }
          },
          "required": [
            "kind",
            "phase"
          ],
          "additionalProperties": false
        }
      ]
    },
    "rule": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/id"
        },
        "trigger": {
          "$ref": "#/$defs/ruleTrigger"
        },
        "priority": {
          "type": "integer",
          "minimum": -100000,
          "maximum": 100000
        },
        "condition": {
          "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/condition"
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/effect"
          }
        }
      },
      "required": [
        "id",
        "trigger",
        "priority",
        "effects"
      ],
