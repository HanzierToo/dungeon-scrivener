            "$ref": "#/$defs/fieldDefinition"
          }
        },
        "allowedTags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "required": [
        "id",
        "name",
        "fields",
