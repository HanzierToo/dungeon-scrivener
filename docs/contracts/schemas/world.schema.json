    },
    "dialogueOption": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/id"
        },
        "text": {
          "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/textSource"
        },
        "condition": {
          "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/condition"
        },
        "falsePolicy": {
          "enum": [
            "hide",
            "disable"
          ]
        },
        "nextLineId": {
          "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/id"
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/effect"
          }
        }
      },
      "required": [
        "id",
        "text",
        "effects"
      ],
      "additionalProperties": false
    },
    "dialogueLine": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/id"
        },
        "speakerEntityId": {
          "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/id"
        },
        "text": {
          "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/textSource"
        },
        "condition": {
          "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/condition"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dialogueOption"
          }
        },
        "nextLineId": {
          "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/id"
        }
      },
      "required": [
        "id",
        "speakerEntityId",
        "text"
      ],
      "additionalProperties": false
    },
    "conversation": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/id"
        },
        "participantEntityIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/id"
          }
        },
        "entryLineId": {
          "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/id"
        },
        "interruptible": {
          "type": "boolean"
        },
        "resumeOnReturn": {
          "type": "boolean"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/dialogueLine"
          }
        }
      },
      "required": [
        "id",
        "participantEntityIds",
        "entryLineId",
        "interruptible",
        "resumeOnReturn",
        "lines"
      ],
      "additionalProperties": false
    },
    "itemDefinition": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/id"
        },
        "name": {
          "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/textSource"
        },
        "stackLimit": {
          "type": "integer",
          "minimum": 1
        },
        "canContain": {
          "type": "boolean"
        },
        "useEventId": {
          "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/id"
        },
        "equipmentSlot": {
          "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/id"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldDefinition"
          }
        }
      },
      "required": [
        "id",
        "name",
        "stackLimit",
        "canContain",
        "fields"
      ],
      "additionalProperties": false
    },
    "initialItemStack": {
      "type": "object",
      "properties": {
        "owner": {
          "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/stateScope"
        },
        "itemId": {
          "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/id"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "containerItemId": {
          "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/id"
        },
        "fields": {
          "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/recordOfScalars"
        }
      },
      "required": [
        "owner",
        "itemId",
        "quantity",
        "fields"
      ],
      "additionalProperties": false
    },
    "scriptSource": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/id"
        },
        "path": {
          "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/path"
        },
        "language": {
          "enum": [
            "javascript",
            "lua",
            "python"
          ]
        },
        "entrypoint": {
          "const": "main"
        }
      },
      "required": [
        "id",
        "path",
        "language",
        "entrypoint"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "format": {
      "const": "dungeon-scrivener-world"
    },
    "schemaVersion": {
      "const": 1
    },
    "entryNodeId": {
      "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/id"
    },
    "settings": {
      "type": "object",
      "properties": {
        "time": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "per-action",
                "elapsed"
              ]
            },
            "millisecondsPerAction": {
              "type": "integer",
              "minimum": 1
            },
            "hiddenBehavior": {
              "enum": [
                "pause",
                "bounded-catch-up"
              ]
            },
            "maxCatchUpMilliseconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 86400000
            },
            "showClockHud": {
              "type": "boolean"
            }
          },
          "required": [
            "mode",
            "hiddenBehavior",
            "maxCatchUpMilliseconds",
            "showClockHud"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "per-action"
                  }
                }
              },
              "then": {
                "required": [
                  "millisecondsPerAction"
                ],
                "properties": {
                  "hiddenBehavior": {
                    "const": "pause"
                  },
                  "maxCatchUpMilliseconds": {
                    "const": 0
                  },
                  "millisecondsPerAction": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "else": {
                "not": {
                  "required": [
                    "millisecondsPerAction"
                  ]
                }
              }
            },
            {
              "if": {
                "properties": {
                  "hiddenBehavior": {
                    "const": "pause"
                  }
                }
              },
              "then": {
                "properties": {
                  "maxCatchUpMilliseconds": {
                    "const": 0
                  }
                }
              },
              "else": {
                "properties": {
                  "maxCatchUpMilliseconds": {
                    "minimum": 1,
                    "type": "integer"
                  }
                }
              }
            }
          ],
          "additionalProperties": false
        },
        "playerStylePath": {
          "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/path"
        }
      },
      "required": [
        "time"
      ],
      "additionalProperties": false
    },
    "savePolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "slotCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "allowedLocation": {
          "enum": [
            "anywhere",
            "checkpoint"
          ]
        },
        "checkpointNodeIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/id"
          }
        }
      },
      "required": [
        "enabled",
        "slotCount",
        "allowedLocation"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "slotCount": {
                "const": 0
              },
              "checkpointNodeIds": {
                "maxItems": 0,
                "type": "array"
              }
            }
          },
          "else": {
            "properties": {
              "slotCount": {
                "minimum": 1,
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "allowedLocation": {
                "const": "checkpoint"
              }
            }
          },
          "then": {
            "required": [
              "checkpointNodeIds"
            ],
            "properties": {
              "checkpointNodeIds": {
                "minItems": 1,
                "type": "array"
              }
            }
          },
          "else": {
            "properties": {
              "checkpointNodeIds": {
                "maxItems": 0,
                "type": "array"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "stateDefinitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stateDefinition"
      }
    },
    "worldState": {
      "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/recordOfScalars"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "navigationEdges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/navigationEdge"
      }
    },
    "entityDefinitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entityDefinition"
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "actionDefaults": {
      "$ref": "#/$defs/actionSet"
    },
    "eventDefinitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/eventDefinition"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "conversations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conversation"
      }
    },
    "itemDefinitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/itemDefinition"
      }
    },
    "initialInventory": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/initialItemStack"
      }
    },
    "scripts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scriptSource"
      }
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "entryNodeId",
    "settings",
    "savePolicy",
    "stateDefinitions",
    "worldState",
    "nodes",
    "navigationEdges",
    "entityDefinitions",
    "entities",
    "actionDefaults",
    "eventDefinitions",
    "rules",
    "conversations",
    "itemDefinitions",
    "initialInventory",
    "scripts"
