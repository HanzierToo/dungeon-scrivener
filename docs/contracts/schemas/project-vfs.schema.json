{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dungeon-scrivener:schema:v1:project-vfs-index",
  "title": "DungeonScrivener project VFS index v1",
  "description": "Serializable metadata for an in-memory project VFS. File bytes are carried separately as Uint8Array and are not rewritten by this index.",
  "type": "object",
  "properties": {
    "format": { "const": "dungeon-scrivener-project-vfs-index" },
    "schemaVersion": { "const": 1 },
    "projectId": { "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/id" },
    "directories": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/path" }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": { "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/path" },
          "byteLength": { "type": "integer", "minimum": 0 },
          "sha256": { "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/sha256" },
          "role": { "enum": ["manifest", "world", "locale", "script", "asset", "arbitrary"] },
          "mediaType": { "type": "string", "maxLength": 128 }
        },
        "required": ["path", "byteLength", "sha256", "role"],
        "additionalProperties": false
      }
    }
  },
  "required": ["format", "schemaVersion", "projectId", "directories", "files"],
  "additionalProperties": false
}
