{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dungeon-scrivener:schema:v1:engine-input",
  "title": "DungeonScrivener bounded engine inputs v1",
  "type": "object",
  "properties": {
    "format": { "const": "dungeon-scrivener-engine-inputs" },
    "schemaVersion": { "const": 1 },
    "sessionStart": {
      "type": "object",
      "properties": {
        "randomSeed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "wallClockEpochMilliseconds": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "visibility": { "enum": ["visible", "hidden"] },
        "focused": { "type": "boolean" }
      },
      "required": ["wallClockEpochMilliseconds", "visibility", "focused"],
      "additionalProperties": false
    },
    "clockInput": {
      "type": "object",
      "properties": {
        "kind": { "enum": ["tick", "visibility-change", "focus-change", "resume"] },
        "wallClockEpochMilliseconds": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "visibility": { "enum": ["visible", "hidden"] },
        "focused": { "type": "boolean" }
      },
      "required": ["kind", "wallClockEpochMilliseconds", "visibility", "focused"],
      "additionalProperties": false
    },
    "playerInput": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": { "const": "choice" },
            "actionId": { "$ref": "urn:dungeon-scrivener:schema:v1:common#/$defs/id" }
          },
          "required": ["kind", "actionId"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "command-text" },
            "rawText": { "type": "string", "maxLength": 1024 }
          },
          "required": ["kind", "rawText"],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": ["format", "schemaVersion", "sessionStart", "clockInput", "playerInput"],
  "additionalProperties": false
}
