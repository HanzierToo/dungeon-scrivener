{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [],
    "resolveJsonModule": true,
    "paths": {
      "@dungeon-scrivener/engine": [
        "../engine/src/index.ts"
      ],
      "@dungeon-scrivener/player-save": [
        "../player-save/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "browser/**/*.ts",
    "browser/**/*.tsx",
    "src/portable-entry.tsx"
  ]
}
